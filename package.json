{
  "name": "classroom-web",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:web api",
    "dev:web": "vite",
    "api": "node --env-file-if-exists=.env server/app.js",
    "dev:full": "npm run dev",
    "demo:full": "node --env-file-if-exists=.env scripts/demo.js",
    "start": "node --env-file-if-exists=.env server/app.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "node --test tests/avatar-policy.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/avatar-upload.test.js",
    "test:e2e": "npm run build && node --test tests/e2e/avatar-browser.test.js",
    "test:e2e:real": "npm run build && node --env-file-if-exists=.env.test --test tests/e2e/avatar-browser.test.js",
    "test:regression": "npm test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "element-plus": "^2.14.8",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "svg-captcha": "^1.4.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "npm-run-all2": "^9.0.4",
    "vite": "8.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
